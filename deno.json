{
  "name": "@incapost/spoke",
  "version": "1.1.3",
  "exports": {
    "./connect": "./connect/mod.ts",
    "./dispatch": "./dispatch/mod.ts"
  },
  "license": "MIT",
  "tasks": {
    "build:dispatch": "deno x openapi-typescript https://developer.dispatch.spoke.com/openapi-v1.json -o ./dispatch/types.d.ts",
    "build:connect": "deno x openapi-typescript https://developer.connect.spoke.com/openapi-connect-v1.json -o ./connect/types.d.ts",
    "ok": "deno fmt --check && deno lint && deno test --doc --coverage"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/crypto": "jsr:@std/crypto@^1.1.0",
    "@std/testing": "jsr:@std/testing@^1.0.20",
    "openapi-fetch": "npm:openapi-fetch@^0.17.0",
    "openapi-typescript": "npm:openapi-typescript@^7.13.0"
  },
  "fmt": {
    "exclude": ["dispatch/types.d.ts", "connect/types.d.ts", "coverage.svg"]
  }
}
